# Copy this file to .env and add your own key. Never commit .env.
OPENAI_API_KEY=
# Optional: gpt-6-luna is the default.
OPENAI_MODEL=gpt-6-luna
# Per-IP request limit for one container instance.
RATE_LIMIT_PER_MINUTE=120
# Port opened on your computer. Change to 8001 if 8000 is already in use.
HOST_PORT=8000
